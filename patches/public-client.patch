+// publicClientRoundTripper converts oauth2's Basic-auth probe into the
+// unauthenticated token request required for an OAuth public client.
+type publicClientRoundTripper struct {
+	clientID      string
+	baseTransport http.RoundTripper
+}
+
+func (rt *publicClientRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	_, password, hasBasicAuth := req.BasicAuth()
+	if !hasBasicAuth || password != "" || req.Body == nil {
+		return rt.baseTransport.RoundTrip(req)
+	}
+
+	body, err := io.ReadAll(req.Body)
+	if err != nil {
+		return nil, err
+	}
+	values, err := url.ParseQuery(string(body))
+	if err != nil {
+		return nil, err
+	}
+	values.Set("client_id", rt.clientID)
+	values.Del("client_secret")
+	encodedBody := values.Encode()
+
+	publicRequest := req.Clone(req.Context())
+	publicRequest.Header = req.Header.Clone()
+	publicRequest.Header.Del("Authorization")
+	publicRequest.Body = io.NopCloser(strings.NewReader(encodedBody))
+	publicRequest.ContentLength = int64(len(encodedBody))
+	publicRequest.GetBody = func() (io.ReadCloser, error) {
+		return io.NopCloser(strings.NewReader(encodedBody)), nil
+	}
+
+	return rt.baseTransport.RoundTrip(publicRequest)
+}
